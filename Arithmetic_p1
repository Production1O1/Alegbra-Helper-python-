                except ValueError:
                    print("Invalid input. Please enter numbers next time.")
                except ZeroDivisionError:
                    print("Invalid input. Please enter a non-zero denominator next time.")
            elif option_fracs == 5:
                # Power of fractions
                try:
                    number = int(input("How many times will you raise the fraction to a power? "))
                    type_of_ans = input("Do you want the answer as a fraction or decimal? (f/d): ").lower()
                    result = fractions.Fraction(input("Starting fraction (base): "))
                    for i in range(number):
                        val = fractions.Fraction(input("Exponent: "))
                        result = result ** val 
                    if type_of_ans == "f":
                        print(f"The result of the power is: {result}")
                    elif type_of_ans == "d":
                        print(f"The result of the power is: {float(result)}")
                    else:
                        print("You did not specify properly how you wanted your answer! The below is a fraction in simplest form.")
                        print(f"The result of the power is: {result}")
                except ValueError:
                    print("Invalid input. Please enter numbers next time.")
                except ZeroDivisionError:
                    print("Invalid input. The answer is UNDEFINED.")
                except OverflowError:
                    print("The result is too large to represent.")
            else: 
                print("Invalid input. Your choice was not recognized.")
        except ValueError: 
            print("Invalid input. Please enter numbers next time.")
    else: 
        print("That was not an option. Please select a valid choice!")

