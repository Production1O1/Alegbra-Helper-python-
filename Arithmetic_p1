                        print(f"The result of the subtraction is: {float(result)}")
                    else:
                        print("You did not specify properly how you wanted your answer! The below is a fraction in simplest form.")
                        print(f"The result of the subtraction is: {result}")
                except ValueError:
                    print("Invalid input. Please enter numbers next time.")
                except ZeroDivisionError:
                    print("Invalid input. Please enter a non-zero denominator next time.")
            elif option_fracs == 3:
                # Multiply fractions
                try:
                    number = int(input("How many times will you multiply the fractions? "))
                    type_of_ans = input("Do you want the answer as a fraction or decimal? (f/d): ").lower()
                    result = fractions.Fraction(input("Starting fraction (multiplicand): "))
                    for i in range(number):
                        val = fractions.Fraction(input("Fraction: "))
                        result = result * val 
                    if type_of_ans == "f":
                        print(f"The result of the multiplication is: {result}")
                    elif type_of_ans == "d":
                        print(f"The result of the multiplication is: {float(result)}")
                    else:
                        print("You did not specify properly how you wanted your answer! The below is a fraction in simplest form.")
                        print(f"The result of the multiplication is: {result}")
                except ValueError:
                    print("Invalid input. Please enter numbers next time.")
                except ZeroDivisionError:
                    print("Invalid input. Please enter a non-zero denominator next time.")
            elif option_fracs == 4:
                # Divide fractions
                try:
                    number = int(input("How many times will you divide the fractions? "))
                    type_of_ans = input("Do you want the answer as a fraction or decimal? (f/d): ").lower()
                    result = fractions.Fraction(input("Starting fraction (dividend): "))
                    for i in range(number):
                        val = fractions.Fraction(input("Fraction: "))
                        result = result / val 
                    if type_of_ans == "f":
                        print(f"The result of the division is: {result}")
                    elif type_of_ans == "d":
                        print(f"The result of the division is: {float(result)}")
                    else:
                        print("You did not specify properly how you wanted your answer! The below is a fraction in simplest form.")
